{
  "schema_version": 4,
  "source": {
    "source_id": "pid-gtfs", "excluded_route_types": ["2"], "maximum_snapshot_skew_days": 7,
    "route_join": {"table": "route_sub_agencies.txt", "source_keys": ["route_id", "sub_agency_id"], "lookup_keys": ["route_id", "sub_agency_id"], "value_column": "route_licence_number", "target_namespace": "cis_line_id"},
    "stop_match": {"group_column": "asw_node_id", "post_column": "asw_stop_id", "maximum_distance_metres": 300, "split_flat_groups_by_name": true, "contextual_inference": {"enabled": true, "minimum_mapped_calls": 1}},
    "trip_match": {"time_resolution_seconds": 60, "exact_pattern_proximity": true, "pattern_edit": {"enabled": true, "maximum_edits": 3, "minimum_agreement": 0.9, "require_same_endpoints": true}, "source_revision": {"column": "trip_id", "regex": "_(?<revision>\\d{6})(?:_|$)", "date_format": "yyMMdd"}, "minimum_capability_tier": {"call_boarding_points": "pattern_edit_nearest", "shapes": "pattern_edit_nearest", "schedules": "pattern_nearest", "transfers": "pattern_nearest"}},
    "trip_set_authority": {"modes": ["bus", "tram", "metro", "trolleybus", "ferry"], "source_native_modes": ["bus", "tram", "metro", "trolleybus", "ferry"]},
    "route_match_tiers": ["companion_assertion", "structural_trip_evidence"],
    "trip_match_tiers": ["full_signature", "pattern_endpoints", "pattern_first", "pattern_nearest", "pattern_edit_nearest"],
    "capabilities": ["stop_coordinates", "boarding_points", "call_boarding_points", "shapes", "route_short_name", "route_long_name", "route_color", "route_text_color", "transfers", "schedules"],
    "overrides": {"stops": "pid-stop-overrides.csv"}
  }
}
