#!/bin/sh
# Fetch, load and activate the newest published build (BASE_PLAN.md section 16.1).
# Every step is idempotent: a fetched release is not downloaded again, a loaded package is not
# loaded again, and a release no newer than those activated before is left alone, so the timer
# can run this often and a failed step is simply retried on the next run.
set -eu

obehy() {
    uv run --no-sync obehy "$@"
}

release_dir=$(obehy release fetch)
obehy release load "$release_dir"
obehy release activate --if-newer "$(basename "$release_dir")"
