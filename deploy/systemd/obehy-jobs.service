[Unit]
Description=Oběhy: nightly jobs (vehicle days, observation retention)
After=network-online.target postgresql.service

[Service]
Type=oneshot
User=obehy
Group=obehy
WorkingDirectory=/opt/obehy
EnvironmentFile=-/etc/obehy/release.env
ExecStart=/usr/bin/env uv run --no-sync obehy jobs nightly
Nice=10
