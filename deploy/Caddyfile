# Serves the GTFS-RT feed and the static GTFS of the active release from the data volume, over
# plain HTTP: TLS and the public hostname belong to the reverse proxy in front.
{
	auto_https off
}

:80 {
	encode zstd gzip

	handle /gtfs-rt/*.pb {
		root * /srv
		header Content-Type application/x-protobuf
		header Cache-Control "no-cache"
		file_server
	}
	# Every feed under one stable name, served from the active release (or the worker's
	# output), and their list from `obehy release feed-list`.
	redir /get-feeds /get-feeds/
	handle_path /get-feeds/* {
		root * /srv
		route {
			@list path / /feeds.json
			header @list Cache-Control "no-cache"
			@realtime path /cz-jdf-gtfs-rt.pb
			header @realtime Content-Type application/x-protobuf
			header @realtime Cache-Control "no-cache"
			rewrite /cz-jdf-gtfs.zip /releases/active/jdf/gtfs.zip
			rewrite /cz-jdf-filtered-gtfs.zip /releases/active/jdf-filtered/gtfs.zip
			rewrite /cz-czptt-gtfs.zip /releases/active/czptt/gtfs.zip
			rewrite /cz-jdf-gtfs-rt.pb /gtfs-rt/jdf.pb
			rewrite / /public/index.html
			rewrite /feeds.json /public/feeds.json
			@served path /releases/active/* /gtfs-rt/* /public/*
			file_server @served
			respond 404
		}
	}
	handle {
		respond 404
	}
}
